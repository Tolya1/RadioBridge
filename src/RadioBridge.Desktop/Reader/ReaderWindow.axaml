<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RadioBridge.Desktop.Reader.ReaderWindow"
        Width="900" Height="760" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Icon="avares://RadioBridge/Assets/radiobridge.ico"
        RequestedThemeVariant="Dark"
        Background="#16181c">

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <TabControl x:Name="Tabs" Grid.Row="0" Margin="12,12,12,0" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="12" ColumnSpacing="10">
            <TextBlock x:Name="Hint" VerticalAlignment="Center" Foreground="#7d828c" FontSize="12" TextWrapping="Wrap" />
            <Button x:Name="DontShowAgain" Grid.Column="1" Content="Don't show again" IsVisible="False" Click="OnDontShowAgain" />
            <Button Grid.Column="2" Content="Close" MinWidth="90" HorizontalContentAlignment="Center" IsDefault="True" IsCancel="True" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
