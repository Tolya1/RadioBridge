<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RadioBridge.Desktop"
        x:Class="RadioBridge.Desktop.MainWindow"
        x:DataType="local:MainViewModel"
        Title="RadioBridge"
        Icon="avares://RadioBridge/Assets/radiobridge.ico"
        Width="740" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark"
        Background="#16181c">

    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#0d0e10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="BorderBrush" Value="#2a2d33" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.segment">
            <Setter Property="Background" Value="#050505" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="#30333a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Width" Value="170" />
        </Style>
        <Style Selector="TextBlock.segment">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, Menlo, monospace" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#ff4b2b" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="TextBlock.mode">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#c9ccd2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="64" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#7d828c" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#c9ccd2" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="#5a5f69" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.dot.on">
            <Setter Property="Fill" Value="#3ccf6e" />
        </Style>
        <Style Selector="Ellipse.dot.recording">
            <Setter Property="Fill" Value="#ff4b2b" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Width" Value="120" />
            <Setter Property="FormatString" Value="0" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="16" Spacing="12">

        <!-- status -->
        <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="RadioBridge" FontSize="18" FontWeight="SemiBold" Foreground="#e8eaee" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
                <Ellipse Classes="dot" Classes.on="{Binding PanelConnected}" />
                <TextBlock Text="{Binding PanelStatus}" Foreground="#c9ccd2" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Ellipse Classes="dot" Classes.on="{Binding SimConnected}" />
                <TextBlock Text="{Binding SimStatus}" Foreground="#c9ccd2" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- why no simulator connects, when it is something the user can fix -->
        <Border IsVisible="{Binding HasNotice}" Background="#33280f" BorderBrush="#c98a1b" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#f2d9a6" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Locate SimConnect.dll…" IsVisible="{Binding CanLocateSimConnect}" Click="OnLocateSimConnect" />
            </Grid>
        </Border>

        <!-- panel replica -->
        <Border Classes="panel">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="64,170,170,58,84" ColumnSpacing="14">
                    <TextBlock Grid.Column="1" Classes="caption" Text="ACTIVE" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="STANDBY" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="caption" Text="KNOBS" HorizontalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="64,170,170,58,84" ColumnSpacing="14">
                    <TextBlock Classes="mode" Text="{Binding UpperMode}" />
                    <Border Grid.Column="1" Classes="segment"><TextBlock Classes="segment" Text="{Binding UpperLeft}" /></Border>
                    <Border Grid.Column="2" Classes="segment"><TextBlock Classes="segment" Text="{Binding UpperRight}" /></Border>
                    <local:KnobView Grid.Column="3" InnerTurns="{Binding UpperInnerTurns}" OuterTurns="{Binding UpperOuterTurns}" />
                    <local:XferView Grid.Column="4" Pressed="{Binding UpperPressed}" Held="{Binding UpperHeld}" />
                </Grid>
                <Grid ColumnDefinitions="64,170,170,58,84" ColumnSpacing="14">
                    <TextBlock Classes="mode" Text="{Binding LowerMode}" />
                    <Border Grid.Column="1" Classes="segment"><TextBlock Classes="segment" Text="{Binding LowerLeft}" /></Border>
                    <Border Grid.Column="2" Classes="segment"><TextBlock Classes="segment" Text="{Binding LowerRight}" /></Border>
                    <local:KnobView Grid.Column="3" InnerTurns="{Binding LowerInnerTurns}" OuterTurns="{Binding LowerOuterTurns}" />
                    <local:XferView Grid.Column="4" Pressed="{Binding LowerPressed}" Held="{Binding LowerHeld}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- settings, collapsed by default to keep the window compact -->
        <Expander Header="Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Border Classes="panel">
            <StackPanel Spacing="4">
                <TextBlock Classes="h2" Text="COM" Margin="0,0,0,4" />
                <CheckBox IsChecked="{Binding Spacing833}" Content="8.33 kHz channels on the inner knob (long-press ACT/STBY on COM to toggle)" />
                <CheckBox IsChecked="{Binding CompactCom}" Content="Compact display: 123.405 shows as 23.405" />

                <TextBlock Classes="h2" Text="Transponder / altimeter" />
                <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                    <TextBlock Text="Altimeter unit" VerticalAlignment="Center" />
                    <RadioButton Grid.Column="1" GroupName="Baro" IsChecked="{Binding BaroHpa}" Content="hPa" />
                    <RadioButton Grid.Column="2" GroupName="Baro" IsChecked="{Binding BaroInHg}" Content="inHg" />

                    <TextBlock Grid.Row="1" Text="VFR squawk (hold ACT/STBY)" VerticalAlignment="Center" />
                    <RadioButton Grid.Row="1" Grid.Column="1" GroupName="Vfr" IsChecked="{Binding Vfr7000}" Content="7000 (Europe)" />
                    <RadioButton Grid.Row="1" Grid.Column="2" GroupName="Vfr" IsChecked="{Binding Vfr1200}" Content="1200 (US)" />
                </Grid>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="XPDR: squawk on the left (outer knob = first two digits, inner = last two), altimeter on the right. Press ACT/STBY to switch which one the knobs edit. Hold it to set the VFR squawk, or standard pressure when the altimeter is selected." />

                <TextBlock Classes="h2" Text="COM knob acceleration" />
                <CheckBox IsChecked="{Binding AccelerationEnabled}" Content="Accelerate fast spins on COM1 and COM2 (all other knobs move one step per detent)" />
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                    <TextBlock Text="Fast below (ms)" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Minimum="5" Maximum="500" Value="{Binding FastDetentMs}" />
                    <TextBlock Grid.Column="2" Text="steps ×" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="3" Minimum="1" Maximum="50" Value="{Binding FastMultiplier}" />

                    <TextBlock Grid.Row="1" Text="Medium below (ms)" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="1000" Value="{Binding MediumDetentMs}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="steps ×" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="1" Maximum="50" Value="{Binding MediumMultiplier}" />

                    <TextBlock Grid.Row="2" Text="Long press (ms)" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="200" Maximum="3000" Increment="50" Value="{Binding LongPressMs}" />
                </Grid>

                <TextBlock Classes="h2" Text="Window" />
                <CheckBox IsChecked="{Binding ShowReaderAtStart}" Content="Show the readme and notices when RadioBridge starts" />
                <CheckBox IsChecked="{Binding CloseToTray}" Content="Keep running in the tray when the window is closed" />
                <CheckBox IsChecked="{Binding StartInTray}" Content="Start hidden in the tray (minimized if the tray option is off)" />

                <TextBlock Classes="h2" Text="Test mode" />
                <CheckBox IsChecked="{Binding TestMode}" IsEnabled="{Binding !TestModeForced}"
                          Content="Drive the panel with built-in test radios while no simulator is connected" />
                <TextBlock Classes="caption" IsVisible="{Binding TestModeForced}" Text="On for this run (started with --test-mode)." />

                <TextBlock Classes="h2" Text="Debug" />
                <CheckBox IsChecked="{Binding RecordAtStart}" Content="Record a debug log every time RadioBridge starts" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="For problems that show up right after starting. Leave it off otherwise: Record debug log below records on demand. The newest 20 recordings are kept." />

                <TextBlock Classes="h2" Text="Simulators (applied on restart)" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox IsChecked="{Binding MsfsEnabled}" Content="MSFS" />
                    <CheckBox IsChecked="{Binding XPlaneEnabled}" Content="X-Plane, Web API port" />
                    <NumericUpDown Minimum="1" Maximum="65535" Width="150" Value="{Binding XPlanePort}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <TextBlock Text="SimConnect library" VerticalAlignment="Center" />
                    <TextBlock Classes="caption" Text="{Binding SimConnectLibrary}" ToolTip.Tip="{Binding SimConnectLibrary}"
                               MaxWidth="330" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Content="Browse…" Click="OnLocateSimConnect" />
                    <Button Content="Automatic" IsVisible="{Binding HasSimConnectPath}" Click="OnUseAutomaticSimConnect" />
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="MSFS is reached through its SimConnect library. RadioBridge uses the one in your MSFS installation, so you only need to browse if it can't find one." />

                <TextBlock Classes="caption" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding SettingsPath, StringFormat='Settings: {0}'}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding LogPath, StringFormat='Logs: {0}'}" />
            </StackPanel>
        </Border>
        </Expander>

        <!-- debug recording, for bug reports -->
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Ellipse Classes="dot" Classes.recording="{Binding IsRecording}" />
            <Button Grid.Column="1" Content="{Binding RecordButtonText}" Click="OnToggleRecording" MinWidth="140"
                    ToolTip.Tip="Records the panel's input and displays, RadioBridge's decisions, and everything sent to and received from the simulator" />
            <TextBlock Grid.Column="2" Classes="caption" Text="{Binding RecordingStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="Open folder" Click="OnOpenRecordings" ToolTip.Tip="{Binding RecordingDirectory}" />
        </Grid>

        <!-- the documents that are built into the executable -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
            <Button Content="Readme" Click="OnOpenReadme" />
            <Button Grid.Column="1" Content="License" Click="OnOpenLicense" />
            <Button Grid.Column="2" Content="Third-party notices" Click="OnOpenNotices" />
            <TextBlock Grid.Column="3" Classes="caption" Text="{Binding VersionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</Window>
