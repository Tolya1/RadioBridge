<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RadioBridge</AssemblyName>
    <!-- All formatting is culture-invariant; this also drops the libicu dependency on Linux. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>Assets\radiobridge.ico</ApplicationIcon>
    <!-- LibraryImport (AttachConsole) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- `dotnet publish -c Release -r <rid> -p:SingleFile=true`: one self-contained executable with the
       .NET runtime inside, compressed. Avalonia's native libraries (Skia, HarfBuzz, ANGLE) ride along
       in the file and are unpacked to a cache folder on first start. -->
  <PropertyGroup Condition="'$(SingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Symbols of referenced projects and native packages (Skia ships 100 MB of .pdb) still land next
       to the executable; a single-file package is just the executable. -->
  <Target Name="RemoveSymbolsFromSingleFilePackage" AfterTargets="Publish" Condition="'$(SingleFile)' == 'true'">
    <ItemGroup>
      <_PublishedSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedSymbols)" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RadioBridge.Core\RadioBridge.Core.csproj" />
  </ItemGroup>

  <!-- SimConnect.dll is Microsoft's and is not committed. For local builds, drop a 64-bit copy in
       ../../libs and it is copied next to the app, the first place the app looks. Never published:
       packages must not redistribute it. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\libs\SimConnect.dll')">
    <None Include="..\..\libs\SimConnect.dll" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
